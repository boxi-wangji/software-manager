{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "软件管家",
  "version": "0.1.0",
  "identifier": "com.wangjiboxi.softwaremanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../构建/前端"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$EXE/data/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
